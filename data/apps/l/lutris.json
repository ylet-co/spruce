{"id":"lutris","name":"Lutris","tagline":"Video game preservation platform","blurb":"Installs and launches Windows games on Linux using community scripts and Wine/Proton.","description":"Lutris helps you install and play video games from all eras and from most gaming systems. By leveraging and combining existing emulators, engine re-implementations and compatibility layers, it gives you a central interface to launch all your games.","developer":"Lutris Team","icon":"https://dl.flathub.org/media/net/lutris/Lutris/3cc8d32fd68604816f0a5f6872bf91b5/icons/128x128/net.lutris.Lutris.png","screenshots":[{"full":"https://dl.flathub.org/media/net/lutris/Lutris/3cc8d32fd68604816f0a5f6872bf91b5/screenshots/image-1_orig.png","thumb":"https://dl.flathub.org/media/net/lutris/Lutris/3cc8d32fd68604816f0a5f6872bf91b5/screenshots/image-1_752x486@1.png","w":1674,"h":1083}],"categories":["Games"],"tags":["game launcher","wine","proton","gaming","linux","game-launcher"],"license":"GPL-3.0-or-later","platforms":["linux","macos"],"repo":"https://github.com/lutris/lutris","homepage":"https://lutris.net","stars":10317,"version":"0.5.22","updated":"2026-02-24","replaces":["Steam","GOG Galaxy","Playnite"],"install":[{"platform":"linux","distro":"linux","manager":"flatpak","label":"Flatpak","recommended":true,"command":"flatpak install flathub net.lutris.Lutris","note":"Works on every distro, sandboxed and always up to date."},{"platform":"linux","distro":"ubuntu","manager":"apt","label":"APT","command":"sudo apt install lutris","note":"Debian-family distros. Package name: lutris"},{"platform":"linux","distro":"fedora","manager":"dnf","label":"DNF","command":"sudo dnf install lutris","note":"Fedora-family distros. Package name: lutris"},{"platform":"linux","distro":"arch","manager":"pacman","label":"Pacman","command":"sudo pacman -S lutris","note":"Arch-family distros. Package name: lutris"},{"platform":"macos","distro":"macos","manager":"brew","label":"Homebrew","recommended":true,"command":"brew install --cask lutris","note":"Or plain `brew install lutris` for the command-line build if the cask is missing."},{"platform":"source","distro":"source","manager":"source","label":"Build from source","url":"https://github.com/lutris/lutris","command":"git clone https://github.com/lutris/lutris.git","note":"For contributors and people whose distro has no package yet."}],"sources":["flathub","github"],"summary":"Video game preservation platform","flathubCategories":["Game","PackageManager"],"language":"Python","featured":true}