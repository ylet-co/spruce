{"id":"quickbib","name":"QuickBib","tagline":"Quickly get BibTeX from a DOI","blurb":"QuickBib helps you quickly generate BibTeX bibliographic entries from identifiers such as DOIs, arXiv IDs, article URLs and their titles.","description":"QuickBib helps you quickly generate BibTeX bibliographic entries from identifiers such as DOIs, arXiv IDs, article URLs and their titles. Enter an identifier and QuickBib will fetch the metadata and produce a ready-to-use BibTeX entry which you can copy to your clipboard and use in your LaTeX documents.\n\nFeatures include: fast DOI/arXiv lookup and copy-to-clipboard.","developer":"Archisman Panigrahi","icon":"https://dl.flathub.org/media/io/github/archisman_panigrahi.QuickBib/46f7c94e503d4402827481b067b1f817/icons/128x128/io.github.archisman_panigrahi.QuickBib.png","screenshots":[{"full":"https://dl.flathub.org/media/io/github/archisman_panigrahi.QuickBib/46f7c94e503d4402827481b067b1f817/screenshots/image-1_orig.png","thumb":"https://dl.flathub.org/media/io/github/archisman_panigrahi.QuickBib/46f7c94e503d4402827481b067b1f817/screenshots/image-1_624x498@1.png","w":643,"h":514},{"full":"https://dl.flathub.org/media/io/github/archisman_panigrahi.QuickBib/46f7c94e503d4402827481b067b1f817/screenshots/image-2_orig.png","thumb":"https://dl.flathub.org/media/io/github/archisman_panigrahi.QuickBib/46f7c94e503d4402827481b067b1f817/screenshots/image-2_624x498@1.png","w":643,"h":514},{"full":"https://dl.flathub.org/media/io/github/archisman_panigrahi.QuickBib/46f7c94e503d4402827481b067b1f817/screenshots/image-3_orig.png","thumb":"https://dl.flathub.org/media/io/github/archisman_panigrahi.QuickBib/46f7c94e503d4402827481b067b1f817/screenshots/image-3_624x498@1.png","w":643,"h":514},{"full":"https://dl.flathub.org/media/io/github/archisman_panigrahi.QuickBib/46f7c94e503d4402827481b067b1f817/screenshots/image-4_orig.png","thumb":"https://dl.flathub.org/media/io/github/archisman_panigrahi.QuickBib/46f7c94e503d4402827481b067b1f817/screenshots/image-4_624x523@1.png","w":708,"h":594}],"categories":["Education","Office & Documents"],"tags":["office","education","utility"],"license":"GPL-3.0-only","platforms":["linux"],"repo":"https://github.com/archisman-panigrahi/QuickBib","homepage":"https://archisman-panigrahi.github.io/QuickBib/","stars":null,"version":"0.9.7","updated":"2026-08-24","replaces":[],"install":[{"platform":"linux","distro":"linux","manager":"flatpak","label":"Flatpak","command":"flatpak install flathub io.github.archisman_panigrahi.QuickBib","note":"Works on every distribution, sandboxed and kept up to date for you.","recommended":true}],"sources":["flathub"],"flathubId":"io.github.archisman_panigrahi.QuickBib"}