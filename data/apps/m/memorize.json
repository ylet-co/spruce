{"id":"memorize","name":"Memorize","tagline":"Find matching pairs","blurb":"Memorize is about finding matching pairs.","description":"Memorize is about finding matching pairs. A pair can be images, sounds and text and this could be extended to animations or movie snippets as well. Which pairs match is up to the creator of the game. Memorize is more than a predefined game you can play, it allows you to create new games yourself as well.","developer":"Sugar Labs Community","icon":"https://dl.flathub.org/media/org/sugarlabs/Memorize/82740f3f419ea7673331e3c3871b2cc2/icons/128x128/org.sugarlabs.Memorize.png","screenshots":[{"full":"https://dl.flathub.org/media/org/sugarlabs/Memorize/82740f3f419ea7673331e3c3871b2cc2/screenshots/image-1_orig.png","thumb":"https://dl.flathub.org/media/org/sugarlabs/Memorize/82740f3f419ea7673331e3c3871b2cc2/screenshots/image-1_752x564@1.png","w":1024,"h":768},{"full":"https://dl.flathub.org/media/org/sugarlabs/Memorize/82740f3f419ea7673331e3c3871b2cc2/screenshots/image-2_orig.png","thumb":"https://dl.flathub.org/media/org/sugarlabs/Memorize/82740f3f419ea7673331e3c3871b2cc2/screenshots/image-2_752x564@1.png","w":1024,"h":768},{"full":"https://dl.flathub.org/media/org/sugarlabs/Memorize/82740f3f419ea7673331e3c3871b2cc2/screenshots/image-3_orig.png","thumb":"https://dl.flathub.org/media/org/sugarlabs/Memorize/82740f3f419ea7673331e3c3871b2cc2/screenshots/image-3_752x564@1.png","w":1024,"h":768}],"categories":["Games"],"tags":["game"],"license":"GPL-2.0-or-later AND GPL-3.0-or-later","platforms":["linux"],"homepage":"https://help.sugarlabs.org/memorize.html","stars":null,"version":"59","updated":"2020-02-21","replaces":[],"install":[{"platform":"linux","distro":"linux","manager":"flatpak","label":"Flatpak","command":"flatpak install flathub org.sugarlabs.Memorize","note":"Works on every distribution, sandboxed and kept up to date for you.","recommended":true}],"sources":["flathub"],"flathubId":"org.sugarlabs.Memorize"}