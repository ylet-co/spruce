{"id":"gnote","name":"Gnote","tagline":"A simple note-taking application","blurb":"Gnote is a simple note-taking application for GNOME desktop environment.","description":"Gnote is a simple note-taking application for GNOME desktop environment. It allows you to capture your ideas, link them together using WikiWiki-style links, group together in notebooks and some extra features for everyday use.\n\nNotes can be printed or exported as HTML documents.\n\nGnote also supports synchronization, making it simple to use it on multiple devices.","developer":"The Gnote Team","icon":"https://dl.flathub.org/media/org/gnome/Gnote/bcd5fe8e9861cd4b78b5674e775aa17d/icons/128x128/org.gnome.Gnote.png","screenshots":[{"full":"https://dl.flathub.org/media/org/gnome/Gnote/bcd5fe8e9861cd4b78b5674e775aa17d/screenshots/image-1_orig.png","thumb":"https://dl.flathub.org/media/org/gnome/Gnote/bcd5fe8e9861cd4b78b5674e775aa17d/screenshots/image-1_752x431@1.png","w":887,"h":509},{"full":"https://dl.flathub.org/media/org/gnome/Gnote/bcd5fe8e9861cd4b78b5674e775aa17d/screenshots/image-2_orig.png","thumb":"https://dl.flathub.org/media/org/gnome/Gnote/bcd5fe8e9861cd4b78b5674e775aa17d/screenshots/image-2_752x431@1.png","w":887,"h":509},{"full":"https://dl.flathub.org/media/org/gnome/Gnote/bcd5fe8e9861cd4b78b5674e775aa17d/screenshots/image-3_orig.png","thumb":"https://dl.flathub.org/media/org/gnome/Gnote/bcd5fe8e9861cd4b78b5674e775aa17d/screenshots/image-3_752x431@1.png","w":887,"h":509}],"categories":["Office & Documents","Utilities"],"tags":["utility"],"license":"GPL-3.0-only","platforms":["linux"],"homepage":"https://gitlab.gnome.org/GNOME/gnote/-/wikis/home","stars":null,"version":"50.1","updated":"2026-04-19","replaces":[],"install":[{"platform":"linux","distro":"linux","manager":"flatpak","label":"Flatpak","command":"flatpak install flathub org.gnome.Gnote","note":"Works on every distribution, sandboxed and kept up to date for you.","recommended":true}],"sources":["flathub"],"flathubId":"org.gnom