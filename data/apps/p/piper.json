{"id":"piper","name":"Piper","tagline":"Gaming mouse configuration utility","blurb":"Piper is a graphical user interface to configure gaming mice.","description":"Piper is a graphical user interface to configure gaming mice.\nConfiguration options include changing the resolution (DPI) of the\nmouse, adding and removing profiles, setting LED colors and changing\nbutton behaviors.\n\nPiper requires libratbag’s ratbagd, the daemon to actually communicate with the\nmice. Piper is merely a front end to ratbagd, ratbagd must be\ninstalled and running when Piper is launched.","developer":"libratbag developers","icon":"https://dl.flathub.org/media/org/freedesktop/Piper/45a83a01400dac1877a1523b99824f64/icons/128x128/org.freedesktop.Piper.png","screenshots":[{"full":"https://dl.flathub.org/media/org/freedesktop/Piper/45a83a01400dac1877a1523b99824f64/screenshots/image-1_orig.png","thumb":"https://dl.flathub.org/media/org/freedesktop/Piper/45a83a01400dac1877a1523b99824f64/screenshots/image-1_752x423@1.png","w":960,"h":540},{"full":"https://dl.flathub.org/media/org/freedesktop/Piper/45a83a01400dac1877a1523b99824f64/screenshots/image-2_orig.png","thumb":"https://dl.flathub.org/media/org/freedesktop/Piper/45a83a01400dac1877a1523b99824f64/screenshots/image-2_752x423@1.png","w":960,"h":540},{"full":"https://dl.flathub.org/media/org/freedesktop/Piper/45a83a01400dac1877a1523b99824f64/screenshots/image-3_orig.png","thumb":"https://dl.flathub.org/media/org/freedesktop/Piper/45a83a01400dac1877a1523b99824f64/screenshots/image-3_752x423@1.png","w":960,"h":540}],"categories":["Utilities"],"tags":["utility"],"license":"GPL-2.0-or-later","platforms":["linux"],"homepage":"https://github.com/libratbag/piper/","stars":null,"version":"0.8","updated":"2024-09-24","replaces":[],"install":[{"platform":"linux","distro":"linux","manager":"flatpak","label":"Flatpak","command":"flatpak install flathub org.freedesktop.Piper","note":"Works on every distribution, sandboxed and kept up to date for you.","re