{"id":"fingerpaint","name":"Fingerpaint","tagline":"Draw using your laptop&apos;s touchpad","blurb":"This utility lets you draw using your laptop's touchpad.","description":"This utility lets you draw using your laptop's touchpad.\nPressing any key or clicking the touchpad will finish the drawing.\nYour touchpad will not control the cursor while drawing, though external mice should still work.\nIt has support for both X11 (all desktop environments), and Wayland (just Gnome at the moment).","developer":"Wazzaps","icon":"https://dl.flathub.org/media/io/github/wazzaps.Fingerpaint/8b2cf5cd1dfa53ea3edc0bc50eab3bf1/icons/128x128/io.github.wazzaps.Fingerpaint.png","screenshots":[{"full":"https://dl.flathub.org/media/io/github/wazzaps.Fingerpaint/8b2cf5cd1dfa53ea3edc0bc50eab3bf1/screenshots/image-1_orig.png","thumb":"https://dl.flathub.org/media/io/github/wazzaps.Fingerpaint/8b2cf5cd1dfa53ea3edc0bc50eab3bf1/screenshots/image-1_1248x754@1.png","w":1717,"h":1038},{"full":"https://dl.flathub.org/media/io/github/wazzaps.Fingerpaint/8b2cf5cd1dfa53ea3edc0bc50eab3bf1/screenshots/image-2_orig.png","thumb":"https://dl.flathub.org/media/io/github/wazzaps.Fingerpaint/8b2cf5cd1dfa53ea3edc0bc50eab3bf1/screenshots/image-2_752x611@1.png","w":1048,"h":852}],"categories":["Graphics & Design","Utilities"],"tags":["graphics","2dgraphics","rastergraphics","art","utility"],"license":"GPL-2.0","platforms":["linux"],"homepage":"https://github.com/Wazzaps/fingerpaint","stars":null,"version":"1.4.3","updated":"2024-05-11","replaces":[],"install":[{"platform":"linux","distro":"linux","manager":"flatpak","label":"Flatpak","command":"flatpak install flathub io.github.wazzaps.Fingerpaint","note":"Works on every distribution, sandboxed and kept up to date for you.","recommended":true}],"sources":["flathub"],"flathubId":"io.github.wazzaps.Fingerpaint"}