{"id":"fonts","name":"Fonts","tagline":"View fonts on your system","blurb":"Fonts shows you the fonts installed on your computer for your use as thumbnails.","description":"Fonts shows you the fonts installed on your computer for your use as\nthumbnails.\nSelecting any thumbnails shows the full view of how the font would look under\nvarious sizes.\n\nFonts also supports installing new font files downloaded in the .ttf\nand other formats.\nFonts may be installed only for your use or made available to all users on the computer.","developer":"The GNOME Project","icon":"https://dl.flathub.org/media/org/gnome/font-viewer/388b0b0297e7199e8bf79d73cb5a575e/icons/128x128/org.gnome.font-viewer.png","screenshots":[{"full":"https://dl.flathub.org/media/org/gnome/font-viewer/388b0b0297e7199e8bf79d73cb5a575e/screenshots/image-1_orig.png","thumb":"https://dl.flathub.org/media/org/gnome/font-viewer/388b0b0297e7199e8bf79d73cb5a575e/screenshots/image-1_752x537@1.png","w":1050,"h":750},{"full":"https://dl.flathub.org/media/org/gnome/font-viewer/388b0b0297e7199e8bf79d73cb5a575e/screenshots/image-2_orig.png","thumb":"https://dl.flathub.org/media/org/gnome/font-viewer/388b0b0297e7199e8bf79d73cb5a575e/screenshots/image-2_752x537@1.png","w":1050,"h":750},{"full":"https://dl.flathub.org/media/org/gnome/font-viewer/388b0b0297e7199e8bf79d73cb5a575e/screenshots/image-3_orig.png","thumb":"https://dl.flathub.org/media/org/gnome/font-viewer/388b0b0297e7199e8bf79d73cb5a575e/screenshots/image-3_752x537@1.png","w":1050,"h":750}],"categories":["Graphics & Design","Utilities"],"tags":["utility"],"license":"GPL-2.0+","platforms":["linux"],"homepage":"https://apps.gnome.org/FontViewer/","stars":null,"version":"50.0","updated":"2026-03-14","replaces":[],"install":[{"platform":"linux","distro":"linux","manager":"flatpak","label":"Flatpak","command":"flatpak install flathub org.gnome.font-viewer","note":"Works on every distribution, sandboxed and kept up to date for you.","recommended":true}],"sources":["f